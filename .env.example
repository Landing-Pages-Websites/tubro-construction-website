# ------------------------------------------------------------------
# Tracking env vars (tracking contract v1, from site-starter).
#
# All optional: each loader renders nothing until its var exists.
# Set in Vercel, never committed.
# ------------------------------------------------------------------

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Loads gtag.js after the
# consent default, only where tracking runs (a production deploy, or the preview
# opt-in below), so a preview deploy never sends hits to the real property.
NEXT_PUBLIC_GA4_ID=

# MEGA managed site id (the site's UUID). Sent as `mega_site_id` on every
# PostHog event so the shared MEGA Websites project can split traffic per site.
# The lead route does not read it: src/lib/lead-server.ts sends its own ids.
NEXT_PUBLIC_MEGA_SITE_ID=

# PostHog is lazy-loaded through the /ingest reverse proxy into the shared MEGA
# Websites project. The project key and host are constants in
# src/lib/tracking/destination.ts; NEXT_PUBLIC_POSTHOG_KEY and
# NEXT_PUBLIC_POSTHOG_HOST are no longer read, so do not set them.
# Tracking runs only on a production deploy. next.config.ts derives the
# browser's NEXT_PUBLIC_VERCEL_ENV from VERCEL_ENV, which Vercel sets on every
# build, so do not set NEXT_PUBLIC_VERCEL_ENV here: it is overwritten.

# Set to 1 to run tracking (PostHog and GA4) outside production, for local
# verification only.
NEXT_PUBLIC_MEGA_TRACKING_PREVIEW=

# Set to 1 to turn all PostHog and GA4 tracking off everywhere, even in
# production. It wins over NEXT_PUBLIC_MEGA_TRACKING_PREVIEW.
NEXT_PUBLIC_MEGA_TRACKING_DISABLED=

# reCAPTCHA Enterprise site key for the lead forms (unchanged by tracking).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
